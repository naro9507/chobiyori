{
  "name": "dcs-accounting-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "個人事業主向けの確定申告用会計ソフト",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naro9507/dcs-accounting-app.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --config apps/renderer/vite.config.ts",
    "build": "tauri build",
    "build:web": "vite build --config apps/renderer/vite.config.ts",
    "tauri": "tauri",
    "test": "vitest run --config apps/renderer/vite.config.ts",
    "test:watch": "vitest --config apps/renderer/vite.config.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "biome lint apps/renderer/src",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "biome format apps/renderer/src",
    "format:fix": "biome format --write apps/renderer/src",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "biome check apps/renderer/src",
    "check:fix": "biome check --write apps/renderer/src",
    "typecheck": "tsc --noEmit -p apps/renderer && tsc --noEmit -p apps/renderer/tsconfig.node.json",
    "prepare": "husky",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@biomejs/biome": "^2.6.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
