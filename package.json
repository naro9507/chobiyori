{
  "name": "chobiyori",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "個人事業主向けの確定申告用会計ソフト",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naro9507/chobiyori.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --locked --workspace --manifest-path src-tauri/Cargo.toml",
    "lint": "biome lint src",
    "lint:rust": "cargo clippy --locked --workspace --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "format:rust": "cargo fmt --all --manifest-path src-tauri/Cargo.toml --check",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "prepare": "husky",
    "release:prepare": "changeset version && node scripts/sync-rust-version.mjs",
    "audit": "pnpm audit --audit-level high && cd src-tauri && cargo audit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@biomejs/biome": "^2.6.7",
    "@changesets/cli": "3.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
