{
  "app": "dcs-accounting",
  "kind": "importFormat",
  "version": 1,
  "name": "住信SBIネット銀行",
  "sourceKind": "bank",
  "definition": {
    "encoding": "shiftJis",
    "delimiter": "comma",
    "headerRow": 1,
    "columns": [
      "date",
      "merchant",
      "withdrawal",
      "deposit",
      "ignore",
      "memo"
    ],
    "sign": "spendNegative",
    "skipUnreadableDates": true,
    "header": [
      "日付",
      "内容",
      "出金金額(円)",
      "入金金額(円)",
      "残高(円)",
      "メモ"
    ]
  }
}
