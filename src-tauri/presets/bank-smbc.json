{
  "app": "dcs-accounting",
  "kind": "importFormat",
  "version": 1,
  "name": "三井住友銀行",
  "sourceKind": "bank",
  "definition": {
    "encoding": "shiftJis",
    "delimiter": "comma",
    "headerRow": 1,
    "columns": [
      "date",
      "withdrawal",
      "deposit",
      "merchant",
      "ignore",
      "memo",
      "ignore"
    ],
    "sign": "spendNegative",
    "skipUnreadableDates": true,
    "header": [
      "年月日",
      "お引出し",
      "お預入れ",
      "お取り扱い内容",
      "残高",
      "メモ",
      "ラベル"
    ]
  }
}
