  {"key": "blank6", "no": "㉚", "ja": "", "en": "", "blank": true, "expense": true},
  {"key": "misc_expenses", "no": "㉛", "ja": "雑費", "en": "Miscellaneous expenses", "sum": ["pl.misc_expenses"], "expense": true, "overflow": true},
  {"key": "expenses", "no": "㉜", "ja": "経費の計", "en": "Total expenses", "sum_of_expenses": true, "total": true},
  {"key": "net", "no": "㉝", "ja": "差引金額（⑦−㉜）", "en": "Net (7 − 32)", "formula": ["+gross_profit", "-expenses"], "total": true},
  {"key": "family_salaries", "no": "", "ja": "専従者給与（繰入額等）", "en": "Family employee salaries", "sum": ["pl.family_employee_salaries"]},
  {"key": "income_before_deduction", "no": "", "ja": "青色申告特別控除前の所得金額", "en": "Income before the blue-return deduction", "formula": ["+net", "-family_salaries"], "total": true},
  {"key": "deduction", "no": "", "ja": "青色申告特別控除額", "en": "Blue-return special deduction", "deduction": true},
  {"key": "income", "no": "", "ja": "所得金額", "en": "Income", "formula": ["+income_before_deduction", "-deduction"], "total": true}
 ],
