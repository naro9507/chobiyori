  {"key": "interest", "no": "㉒", "ja": "利子割引料", "en": "Interest and discounts", "sum": ["pl.interest"], "expense": true},
  {"key": "rent", "no": "㉓", "ja": "地代家賃", "en": "Rent", "sum": ["pl.rent"], "expense": true},
  {"key": "bad_debts", "no": "㉔", "ja": "貸倒金", "en": "Bad debts", "sum": ["pl.bad_debts"], "expense": true},
  {"key": "blank1", "no": "㉕", "ja": "", "en": "", "blank": true, "expense": true},
  {"key": "blank2", "no": "㉖", "ja": "", "en": "", "blank": true, "expense": true},
