{
 "_note": "青色申告決算書（一般用）の行の並びと、どの科目（決算書の行のキー）を足すか。様式の改定に備えて年度ごとのデータとして持つ。番号は様式の欄の番号で、改定で変わることがあるので最新の様式と税理士に確認すること。番号が確かでない欄は番号を空にしてある",
 "form": "blue_general",
 "from_year": 2020,
 "deduction": {"blue65": 650000, "blue55": 550000, "blue10": 100000},
 "fallback": {"revenue": "sales", "cogs": "purchases"},
 "pl": [
  {"key": "sales", "no": "①", "ja": "売上（収入）金額（雑収入を含む）", "en": "Sales (including miscellaneous income)", "sum": ["pl.sales", "pl.personal_consumption", "pl.misc_income"]},
  {"key": "opening_inventory", "no": "②", "ja": "期首商品（製品）棚卸高", "en": "Opening inventory", "sum": ["pl.opening_inventory"]},
  {"key": "purchases", "no": "③", "ja": "仕入金額（製品製造原価）", "en": "Purchases", "sum": ["pl.purchases"]},
  {"key": "cogs_subtotal", "no": "④", "ja": "小計（②＋③）", "en": "Subtotal (2 + 3)", "formula": ["+opening_inventory", "+purchases"], "total": true},
  {"key": "closing_inventory", "no": "⑤", "ja": "期末商品（製品）棚卸高", "en": "Closing inventory", "sum": ["pl.closing_inventory"], "negate": true},
  {"key": "cogs", "no": "⑥", "ja": "差引原価（④−⑤）", "en": "Cost of sales (4 − 5)", "formula": ["+cogs_subtotal", "-closing_inventory"], "total": true},
  {"key": "gross_profit", "no": "⑦", "ja": "差引金額（①−⑥）", "en": "Gross profit (1 − 6)", "formula": ["+sales", "-cogs"], "total": true},
  {"key": "taxes_dues", "no": "⑧", "ja": "租税公課", "en": "Taxes and dues", "sum": ["pl.taxes_dues"], "expense": true},
  {"key": "freight", "no": "⑨", "ja": "荷造運賃", "en": "Packing and freight", "sum": ["pl.freight"], "expense": true},
  {"key": "utilities", "no": "⑩", "ja": "水道光熱費", "en": "Utilities", "sum": ["pl.utilities"], "expense": true},
  {"key": "travel", "no": "⑪", "ja": "旅費交通費", "en": "Travel and transportation", "sum": ["pl.travel"], "expense": true},
  {"key": "communication", "no": "⑫", "ja": "通信費", "en": "Communication", "sum": ["pl.communication"], "expense": true},
  {"key": "advertising", "no": "⑬", "ja": "広告宣伝費", "en": "Advertising", "sum": ["pl.advertising"], "expense": true},
